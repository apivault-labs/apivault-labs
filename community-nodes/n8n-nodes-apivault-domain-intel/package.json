    "subdomain-finder",
    "osint",
    "security-audit",
    "lead-enrichment",
    "builtwith-alternative",
    "apify"
  ],
  "author": {
    "name": "ApiVault Labs",
    "email": "68965192+apivault-labs@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apivault-labs/apivault-labs.git",
    "directory": "community-nodes/n8n-nodes-apivault-domain-intel"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.cjs",
    "lint": "n8n-node lint",
