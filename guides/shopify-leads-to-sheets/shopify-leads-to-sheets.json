    {
      "id": "1e44e26a-6c57-552c-858e-2c937aedb7d0",
      "name": "Start Actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        140
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/apivault_labs~website-leads-database/runs",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "build",
              "value": "0.17.5"
            },
            {
              "name": "memory",
              "value": "256"
            },
            {
              "name": "timeout",
              "value": "600"
            },
            {
              "name": "maxTotalChargeUsd",
              "value": "={{ $json.maxTotalChargeUsd }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.actorInput) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "167b609f-7967-530d-aa7c-b8f703f49ea9",
      "name": "Validate run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json.data;\nif (!r || !/^[A-Za-z0-9]{17}$/.test(r.id||'') || r.actId!=='InYi5NI4KMb8xo5u9') throw new Error('Run is missing or belongs to another Actor.');\nif (!['READY','RUNNING','SUCCEEDED','FAILED','ABORTING','ABORTED','TIMING-OUT','TIMED-OUT'].includes(r.status)) throw new Error('Unknown run status; inspect this run without starting another.');\nif (['FAILED','ABORTED','TIMED-OUT','ABORTING','TIMING-OUT'].includes(r.status)) throw new Error(`Run ${r.id}: ${r.status}. Inspect its log and stored results; do not create another run automatically.`);\nconst started=Date.parse(r.startedAt||r.createdAt||'');\nif (!Number.isFinite(started)) throw new Error('Missing valid start time.');\nif (r.status!=='SUCCEEDED' && Date.now()-started>15*60*1000) throw new Error(`Polling stopped for ${r.id}. Resume this same run after checking Console.`);\nif (!/^[A-Za-z0-9]{17}$/.test(r.defaultDatasetId||'') || !/^[A-Za-z0-9]{17}$/.test(r.defaultKeyValueStoreId||'')) throw new Error('Missing run storage IDs.');\nreturn [{json:{...r,ready:r.status==='SUCCEEDED'}}];"
      }
    },
