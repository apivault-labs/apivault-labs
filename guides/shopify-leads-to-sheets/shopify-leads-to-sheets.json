    {
      "id": "c6f1b451-7d2d-5846-9f3b-2e93c854dd7c",
      "name": "Validate coverage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        0
      ],
      "parameters": {
        "jsCode": "const s=$input.first().json;\nconst run=$('Validate run').first().json;\nif (s.success!==true || !Number.isInteger(s.rowsReturned) || s.rowsReturned<0 || s.failedShards!==0) throw new Error(`Review SUMMARY/ERRORS for ${run.id}; source coverage is not confirmed.`);\nif (!['COMPLETED','NO_RESULTS','MAX_ITEMS_REACHED'].includes(s.status)) throw new Error(`Run ${run.id} returned ${s.status}; inspect it without another paid start.`);\nif (['COMPLETED','NO_RESULTS'].includes(s.status) && s.isComplete!==true) throw new Error('Inconsistent completeness in SUMMARY.');\nreturn [{json:{...run,rowsExpected:s.rowsReturned,source_status:s.status,export_scope:s.status==='MAX_ITEMS_REACHED'?'limited_sample':'complete_matching_export'}}];"
      }
    },
    {
      "id": "c5ce56f2-1916-5079-b82e-e689208fda96",
      "name": "Inspect dataset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "url": "={{ 'https://api.apify.com/v2/datasets/' + $json.defaultDatasetId }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "537adeb8-d484-5ccf-89aa-a40bb395da43",
      "name": "Validate dataset",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        0
      ],
      "parameters": {
        "jsCode": "const d=$input.first().json.data;\nconst r=$('Validate coverage').first().json;\nif (!d || d.id!==r.defaultDatasetId || !Number.isInteger(d.itemCount) || d.itemCount!==r.rowsExpected) throw new Error('Dataset count does not match SUMMARY.');\nif (d.itemCount>1000) throw new Error('This template reads at most 1000 already-created rows. Use the paginated API for larger datasets; do not rerun Start Actor.');\nreturn [{json:r}];"
      }
    },
    {
      "id": "d4eb9995-d252-506d-b77e-7c38b2a53f8d",
      "name": "Read lead rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2440,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "url": "={{ 'https://api.apify.com/v2/datasets/' + $json.defaultDatasetId + '/items' }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "clean",
              "value": "true"
            },
            {
              "name": "limit",
              "value": "1000"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "a770f79b-6f09-54e8-a8e1-a31c76212c09",
      "name": "Prepare rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2660,
        0
      ],
      "parameters": {
        "jsCode": "const out=[],seen=new Set();\nconst coverage=$('Validate coverage').first().json;\nfor (const item of $input.all()) {\n const r=item.json,domain=String(r['Root Domain']||'').trim().toLowerCase();\n if (!/^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63}$/.test(domain)) throw new Error('Invalid domain in exported row; inspect Dataset.');\n if (seen.has(domain)) continue;\n seen.add(domain);\n out.push({json:{domain,company:String(r.Company||''),emails:String(r.Emails||''),phones:String(r.Telephones||''),country:String(r.Country||''),ecommerce_platform:String(r['eCommerce Platform']||''),last_found:String(r['Last Found']||''),source_status:coverage.source_status,export_scope:coverage.export_scope}});\n}\nif ($input.all().length!==coverage.rowsExpected) throw new Error('Result page length differs from SUMMARY; do not silently truncate.');\nreturn out;"
      }
    },
    {
      "id": "bdd86f82-e56d-52da-87ca-72f550e911c1",
      "name": "CSV-safe text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        -100
      ],
      "parameters": {
        "jsCode": "return $input.all().map(item=>({json:Object.fromEntries(Object.entries(item.json).map(([k,v])=>[k,typeof v==='string' && /^[=+@\\-\\t\\r]/.test(v)?\"'\"+v:v]))}));"
      }
    },
