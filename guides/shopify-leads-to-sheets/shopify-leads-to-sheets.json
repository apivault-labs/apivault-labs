    {
      "id": "1fe2c64b-2960-5faf-afc2-b623f6116a0c",
      "name": "Configure export",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{\"actorInput\": {\"workflow\": \"export\", \"platforms\": [\"shopify_sites\"], \"country\": [\"US\"], \"hasEmail\": true, \"filters\": [{\"column\": \"eCommerce Platform\", \"operator\": \"contains\", \"value\": \"Shopify\"}], \"dedupeByDomain\": true, \"sortBy\": \"Tranco\", \"sortDesc\": false, \"maxItems\": 10, \"outputPreset\": \"custom\", \"columns\": [\"Root Domain\", \"Company\", \"Emails\", \"Telephones\", \"Country\", \"eCommerce Platform\", \"Last Found\"]}, \"resumeRunId\": \"\", \"sendToGoogleSheets\": false, \"maxTotalChargeUsd\": 0.15}}];"
      }
    },
    {
      "id": "b862d9bc-eab5-5fe1-97f3-ce3e04a884a1",
      "name": "Validate settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const s=$input.first().json;\nif (!s.actorInput || !Number.isInteger(s.actorInput.maxItems) || s.actorInput.maxItems<1 || s.actorInput.maxItems>1000) throw new Error('Set maxItems between 1 and 1000. Start with 10.');\nif (s.actorInput.workflow!=='export') throw new Error('This workflow exports rows; workflow must be export.');\nif (typeof s.sendToGoogleSheets!=='boolean') throw new Error('sendToGoogleSheets must be true or false');\nif (typeof s.maxTotalChargeUsd!=='number' || s.maxTotalChargeUsd<=0 || s.maxTotalChargeUsd>10) throw new Error('Set an explicit event cap greater than 0 and at most $10. It is not an all-cost cap.');\nconst resume=String(s.resumeRunId||'').trim();\nif (resume && !/^[A-Za-z0-9]{17}$/.test(resume)) throw new Error('Use the exact Apify run ID, not a URL.');\nreturn [{json:{...s,resumeRunId:resume,resume:Boolean(resume)}}];"
      }
    },
    {
