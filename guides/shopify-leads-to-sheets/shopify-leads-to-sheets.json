    {
      "id": "118ddcc5-b5fe-5ada-8eab-cee1b2a992ee",
      "name": "Read SUMMARY",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "url": "={{ 'https://api.apify.com/v2/key-value-stores/' + $json.defaultKeyValueStoreId + '/records/SUMMARY' }}",
        "options": {
          "timeout": 60000
        }
