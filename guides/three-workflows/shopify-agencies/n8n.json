      "parameters": {
        "jsCode": "const rows=$input.all().map(i=>i.json).filter(r=>Object.keys(r).length); if(rows.length>1000)throw new Error('Export exceeded 1000 rows. Page the saved dataset before delivery.'); return [{json:{rows,runId:$('Contact require success').first().json.data.id}}];"
