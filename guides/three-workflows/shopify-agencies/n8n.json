      "parameters": {
        "jsCode": "const rows=$input.all().map(i=>i.json); const columns=[\"rowKey\", \"domain\", \"company\", \"country\", \"indexedEmails\", \"observedEmails\", \"contactPage\", \"contactStatus\", \"checkedAt\", \"coverageComplete\", \"sourceRunId\", \"contactRunId\"]; const cell=v=>{let s=String(v??'');if(/^[=+@\\-\\t\\r]/.test(s))s=\"'\"+s; return '\"'+s.replaceAll('\"','\"\"')+'\"';}; const text='\\uFEFF'+[columns.map(cell).join(','),...rows.map(r=>columns.map(c=>cell(r[c])).join(','))].join('\\r\\n')+'\\r\\n'; return [{json:{rows:rows.length,sourceRunId:rows[0]?.sourceRunId??''},binary:{data:await this.helpers.prepareBinaryData(Buffer.from(text,'utf8'),'shopify-agencies.csv','text/csv')}}];"
