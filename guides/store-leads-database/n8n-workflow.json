{
  "name": "Store Leads — small indexed Shopify export",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "start",
      "name": "Start Store Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/apivault_labs~store-leads-database/runs?build=latest&memory=512&timeout=900&waitForFinish=60&maxTotalChargeUsd=0.12",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"storePlatforms\": [\"shopify\"], \"country\": [\"US\"], \"hasEmail\": true, \"maxItems\": 10, \"outputPreset\": \"contacts\"}",
        "options": {
          "timeout": 90000
        }
      }
    },
    {
      "id": "if",
      "name": "Finished successfully",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "status",
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "SUCCEEDED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "items",
      "name": "Download existing dataset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -100
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "url": "={{ 'https://api.apify.com/v2/datasets/' + $('Start Store Leads').first().json.data.defaultDatasetId + '/items?clean=true&format=json' }}",
        "options": {
          "timeout": 90000
        }
      }
    },
    {
      "id": "stop",
      "name": "Recover existing run",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        720,
        120
      ],
      "parameters": {
        "errorMessage": "={{ 'Run ' + $('Start Store Leads').first().json.data.id + ' is not finished successfully. Recover this run in Apify Console; do not start again merely to download results.' }}"
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Start Store Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Store Leads": {
      "main": [
        [
          {
            "node": "Finished successfully",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Finished successfully": {
      "main": [
        [
          {
            "node": "Download existing dataset",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Recover existing run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
